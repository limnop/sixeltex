def render(text: str, args: argparse.Namespace) -> None:
    # 组装模板字段：默认值 <- 命令行覆盖
    fields = dict(DEFAULTS)
    if args.doc_class:
        fields["doc_class"] = args.doc_class
    if args.packages:
        # 使用者给的宏包名列表 -> \usepackage{...} 多行文本
        fields["extra_packages"] = "\n".join(
            "\\usepackage{%s}" % p for p in args.packages)
    if args.preamble:
        fields["preamble_extra"] = args.preamble
    if args.math_env:
        fields["math_env"] = args.math_env
    if args.cjk_font:
        fields["cjk_font"] = args.cjk_font
    if args.latin_font:
        fields["latin_font"] = args.latin_font
    if args.math_font:
        fields["math_font"] = args.math_font

    # 颜色：命令行优先，否则探测
    fg = args.color if args.color else detect_fg()
    bg = args.bgcolor if args.bgcolor else detect_bg()

    # 两层字号，不可混淆：
    #   终端字号  —— 探测得到，只用于算 DPI（结果经 _CELL_H_PX 传递）
    #   fontsize  —— LaTeX 排版字号，固定 10pt（或 -s 指定），决定字形比例
    #
    # 旧实现把两者当成同一个变量：终端字号变大 -> fontsize 变大 -> DPI 变小
    # -> 图反而变小。必须解耦。
    #
    # 这里调用探测是为了拿到终端字符格尺寸(CSI 14t/18t)，结果存进模块级
    # _CELL_H_PX。返回的字号值本身当前不直接使用，故不保存。
    detect_fontsize_pt(args.verbose)
    if args.size is not None:
        fontsize = args.size
    else:
        fontsize = FALLBACK_FONTSIZE_PT
    # 字号接入文档类选项。LaTeX 只认离散档位(10/11/12pt)，
    # 任意 pt 值归到最接近的档位并如实告知。
    fields["class_opts"] = _size_to_class_opt(fontsize)

    # 终端宽度(列数)：按列数限制排版宽度，让 LaTeX 自己换行
    columns = args.width if args.width else detect_terminal_columns()
    width_setup, _ = build_width_setup(columns, enabled=not args.no_wrap)
    fields["width_setup"] = width_setup

    # 页面宽度 = 终端列宽（左右不裁剪的前提）。
    # 一列 = 半个中文字宽 = fontsize/2 pt，故列数/2 * fontsize。
    # 高度留足够大，上下再按内容裁剪。
    if not args.no_wrap:
        paper_w = (columns / 2.0) * fontsize
        fields["paper_w"] = "%.3fpt" % paper_w
        fields["paper_h"] = "%.3fpt" % max(paper_w * 4.0, 200.0)

    # DPI 分两层，这是解决"发糊"的关键：
    #   base_dpi —— 目标数据的等效 DPI，使公式字高与终端文字一致
    #               （终端放大 -> cell_h 变大 -> base_dpi 变大）
    #   dpi      —— 实际光栅化用的 DPI = base_dpi * 超采样倍率
    #
    # 为什么超采样：直接用 base_dpi 渲染时取样密度低，字形边缘锯齿明显，
    # 量化到 256 色后看着发糊。先用 N 倍分辨率渲染，再用 Lanczos 缩回目标
    # 尺寸，等价于高质量抗锯齿，细节明显更清晰。
    if args.dpi is not None:
        base_dpi = args.dpi
        supersample = 1          # 显式指定 DPI 时不超采样，尊重用户意图
    else:
        base_dpi = int(round(compute_dpi_for_cell_height(_CELL_H_PX, fontsize)))
        if base_dpi < 36:
            base_dpi = 36
        supersample = args.supersample

    dpi = base_dpi * supersample

    fields["font_setup"] = build_font_setup(fields)
    fields["color_setup"] = build_color_setup(fields, fg, bg)

    # 输入模式判定
    if is_full_document(text):
        tex = text
        mode = "完整文件"
    else:
        body = wrap_expression(text, fields, args.math_scale)
        # 按终端列宽折行，避免渲染出一行超长内容
        fields["body"] = wrap_body_for_width(body, width_setup)
        tex = TEMPLATE.format(**fields)
        mode = "表达式"

    if args.verbose:
        sys.stderr.write(
            "sixeltex: 模式=%s 前景=%s 背景=%s dpi=%d 字号=%.2fpt 终端=%d列%s\n"
            % (mode, fg, bg, dpi, fontsize, columns,
               " 透传" if args.transparent else " 合成背景"))

    if args.dry_run:
        sys.stderr.write(tex)
        sys.stderr.write("\n")
        return

    workdir_ctx = tempfile.mkdtemp(prefix="sixeltex-")
    try:
        pdf = compile_tex(tex, workdir_ctx)
        pdf = crop_pdf(pdf, workdir_ctx, keep_width=not args.crop_width)
        png = pdf_to_transparent_png(pdf, workdir_ctx, dpi)


        if args.transparent:
            # 透传模式（需显式开启）：只画字形像素，背景不写色
            if args.margin and args.margin > 0:
                bordered = os.path.join(workdir_ctx, "sixeltex-margin.png")
                subprocess.run(
                    [MAGICK, png, "-bordercolor", "transparent",
                     "-border", str(args.margin), bordered],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    timeout=300, check=True)
                png = bordered
            png_to_sixel_transparent(png, fg)
        else:
            # 默认：把透明渲染结果合成到背景色，避免与终端背景撞色
            final = os.path.join(workdir_ctx, "sixeltex-composited.png")
            # 目标宽度 = 终端列数 * 字符格宽(px)，超采样后缩回这个尺寸
            target_w = None
            if not args.no_wrap and not args.dpi:
                cell = _CELL_W_PX if _CELL_W_PX else DEFAULT_CELL_W_PX
                target_w = int(round(columns * cell))
            composite_bg(png, bg, final, args.margin,
                         target_w=target_w, supersample=supersample)
            # -k 保存"最终要显示的那张图"（已缩放、已补边、已合成背景）
            if args.keep_png:
                dest = os.path.abspath(args.keep_png)
                shutil.copyfile(final, dest)
                sys.stderr.write("sixeltex: PNG 已保存到 %s\n" % dest)
            # 把"最终图片的实际像素尺寸"显式传给 icat。
            # 图片尺寸本身已按探测到的终端宽度算好，这里只是告诉 icat
            # 按原样显示、不要再缩放（它的自动适配会引入尺寸漂移）。
            final_w, final_h = _image_size(final)
            png_to_sixel_opaque(final, args.colors, final_w, final_h)
    finally:
        if args.keep_dir:
            sys.stderr.write("sixeltex: 工作目录保留在 %s\n" % workdir_ctx)
        else:
            shutil.rmtree(workdir_ctx, ignore_errors=True)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="sixeltex",
        description="渲染 LaTeX / 中文 / 数学表达式为 sixel 终端图形（走真实 xelatex）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
示例:
  sixeltex '\\frac{1}{1+x}'                单个公式
  sixeltex '$E=mc^2$'                      带 $ 也行，自动剥掉
  echo 'x^2' | sixeltex                   标准输入
  sixeltex '中文测试: $f(x)=x^2$'           中英混排
  sixeltex doc.tex                        完整 .tex 文件(含 \\documentclass)
  sixeltex -t beamer -C "Noto Sans CJK SC" '内容'

环境变量:
  SIXELTEX_FG / SIXELTEX_BG    指定前景/背景色(OSC 探测失败时使用)
""")
    p.add_argument("input", nargs="?", default=None,
                   help="LaTeX 表达式，或完整 .tex 文件路径；省略则读标准输入")
    p.add_argument("-s", "--size", type=float, default=None,
                   help="正文字号(pt)。默认自动探测终端字号（CSI 14t/18t），"
                        "探测失败回退 10pt。LaTeX 只认 10/11/12pt 档位，"
                        "其他值归到最接近档位并提示；连续缩放用 -S")
    p.add_argument("--supersample", type=int, default=3, metavar="N",
                   help="超采样倍率，默认 3。先按 N 倍分辨率渲染再缩回目标"
                        "尺寸，显著减少锯齿、让字更清晰。设 1 关闭")
    p.add_argument("-d", "--dpi", type=int, default=None,
                   help="光栅化分辨率 DPI。默认按 -W 与字号自动反算，"
                        "使内容恰好占满终端列数；显式指定则完全由你决定")
    p.add_argument("-W", "--cell-width", dest="cell_w", type=float,
                   default=DEFAULT_CELL_W_PX,
                   help="终端一个字符格的像素宽，默认 %g。"
                        "决定输出图在终端里占多少列，不准时改它" % DEFAULT_CELL_W_PX)
    p.add_argument("-c", "--color", default=None,
                   help="前景色，命名色或 #RRGGBB。默认 OSC 探测终端色")
    p.add_argument("-b", "--bgcolor", default=None,
                   help="背景色。默认 OSC 探测；此为合到底色，非 LaTeX 页面背景")
    p.add_argument("-m", "--margin", type=int, default=0,
                   help="四周额外留白(像素)，默认 0。内容边界由 ghostscript 自动算")
    p.add_argument("-S", "--math-scale", dest="math_scale", type=float,
                   default=None,
                   help="数学公式连续缩放倍数，如 1.5 或 0.8。默认不缩放。"
                        "仅对纯数学生效，含中文的正文不缩放（避免字形被拉伸）")
    p.add_argument("-p", "--colors", type=int, default=256,
                   help="sixel 调色板颜色数，默认 256")
    p.add_argument("-t", "--doc-class", dest="doc_class", default=None,
                   help="文档类：ctexart(默认)/ctexrep/ctexbook/article/beamer")
    p.add_argument("-P", "--packages", nargs="+", default=None,
                   help="追加宏包列表（空格分隔），如 -P tikz pgfplots")
    p.add_argument("-A", "--preamble", default=None,
                   help="额外插入 preamble 的原文（每行一条）")
    p.add_argument("-e", "--env", dest="math_env", default=None,
                   help="强制指定数学环境，如 align* / equation / gather")
    p.add_argument("-C", "--cjk-font", dest="cjk_font", default=None,
                   help="中文字体名。默认自动探测本机可用中文字体")
    p.add_argument("-L", "--latin-font", dest="latin_font", default=None,
                   help="西文字体名")
    p.add_argument("-M", "--math-font", dest="math_font", default=None,
                   help="数学字体名（需带 MATH 表）")
    p.add_argument("--transparent", action="store_true",
                   help="透传背景：只画字形像素，背景不写色，让终端原样透出。"
                        "默认是把结果合成到 -b/探测到的背景色")
    p.add_argument("--no-wrap", action="store_true",
                   help="关闭按终端列宽自动折行（默认按探测到的列数限制排版宽度）")
    p.add_argument("--crop-width", action="store_true",
                   help="左右也按内容裁剪（默认只裁上下，左右保留整页宽度）")
    p.add_argument("-w", "--width", type=int, default=None,
                   help="强制指定终端列数（默认自动探测，失败用 80）")
    p.add_argument("-n", "--dry-run", action="store_true",
                   help="只打印生成的 .tex 源，不编译渲染")
    p.add_argument("-k", "--keep-png", metavar="FILE", default=None,
                   help="把中间 PNG 另存到指定路径")
    p.add_argument("-K", "--keep-dir", action="store_true",
                   help="保留临时工作目录（含 .tex/.pdf/.log）便于调试")
    p.add_argument("-v", "--verbose", action="store_true", help="打印诊断信息")
    p.add_argument("-V", "--version", action="version",
                   version="sixeltex " + __version__)
    return p


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    check_dependencies()

    # 取输入
    if args.input is None:
        if sys.stdin.isatty():
            sys.stderr.write("sixeltex: 未提供输入。用法: sixeltex '表达式' "
                             "或 sixeltex 文件.tex\n")
            return 2
        text = sys.stdin.read()
    else:
        # 先按文件读；读不到就按表达式字面量处理
        try:
            if os.path.isfile(args.input):
                with open(args.input, encoding="utf-8") as f:
                    text = f.read()
            else:
                text = args.input
        except (OSError, UnicodeDecodeError):
            text = args.input

    if not text.strip():
        sys.stderr.write("sixeltex: 输入为空\n")
        return 2

    render(text, args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
