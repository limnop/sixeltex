def compute_dpi_for_columns(cell_w_px: float, fontsize_pt: float) -> float:
    r"""
    反算 DPI，使"按列数限宽排版"的内容恰好占满 columns 列。

    推导：
      LaTeX 里可用文本宽 = (columns/2) 个中文字宽，1 个中文字宽 = 1em = fontsize_pt。
      所以内容宽 = (columns/2) * fontsize_pt  (单位 pt)
      该内容渲染成像素宽 = 内容宽 * DPI / 72
      要让它在终端占 columns 列，需 像素宽 = columns * cell_w_px
      联立：
          (columns/2) * fontsize_pt * DPI / 72 = columns * cell_w_px
          => DPI = 2 * cell_w_px * 72 / fontsize_pt
      注意 columns 被约掉了——DPI 只取决于 cell_w 和字号，
      与终端列数无关。这正是之前固定 DPI=200 导致超宽近一倍的原因：
      80 列内容本该占 640px，200 DPI 下却渲染成 1103px（约 138 列）。
    """
    if fontsize_pt <= 0 or cell_w_px <= 0:
        return 72.0
    return 2.0 * cell_w_px * 72.0 / fontsize_pt


def compute_dpi_for_cell_height(cell_h_px: float | None,
                                fontsize_pt: float) -> float:
    r"""
    反算 DPI，使公式字高与终端字符格高度一致。

    目标：公式中文字高(px) == 终端字符格高(px)
      LaTeX 里 1em = fontsize_pt (pt)
      渲染后字高(px) = fontsize_pt * DPI / 72
      cell_h_px = fontsize_pt * DPI / 72
      => DPI = cell_h_px * 72 / fontsize_pt

    缩放方向：
      Ctrl++ 放大终端字体 -> 字符格变高 -> cell_h_px 变大 -> DPI 变大
      -> 渲染出的公式字也跟着变大，与终端文字保持同比例。

    为什么改用 cell_h 而不是 cell_w（原先的 bug）：
      旧实现 DPI = 2*cell_w*72/fontsize，但 cell_w 与终端字号都由同一个
      字符格导出（term_pt = cell_h/screen_dpi*72），宽高比固定时代数上
      互相约掉，DPI 恒在屏幕 DPI 附近，终端放大时图毫无变化。
      更糟的是 fontsize 跟着终端字号走且处在分母，方向完全相反。
    """
    if fontsize_pt <= 0:
        return 72.0
    if not cell_h_px or cell_h_px <= 0:
        # 终端不响应 CSI 查询时按 16px 字高兜底（约等于常见终端默认）
        cell_h_px = 16.0
    dpi = cell_h_px * 72.0 / fontsize_pt
    return max(36.0, min(dpi, 600.0))


def estimate_paper_height(text: str, columns: int, fontsize: float) -> float:
    r"""
    估算把 text 按 columns 列宽排版需要多少页面高度(pt)。

    为什么需要：页面高度若不够，LaTeX 会把内容分页，而 pdftocairo
    用 -singlefile 只栅格化第 1 页，第 2 页起的内容会被静默丢弃
    （实测 5760 字符中文溢出 1600pt 页面，2 页，丢失 1640 字）。

    估算宁可偏高：页面高一些只是中间 PDF 变大，后续会按内容 bbox
    裁剪；估低的后果则是内容直接丢失。

    宽度单位：中文/全角字符占 2 个半宽，其余占 1 个。columns 列宽
    可容纳 columns 个半宽单位，故行数 ≈ 总单位数 / columns。
    """
    if columns <= 0 or fontsize <= 0:
        return 1600.0

    units = 0
    for ch in text:
        if ch == "\n":
            units += columns          # 强制换行：至少占满一行
            continue
        units += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1

    lines = max(1, -(-units // columns))     # 向上取整
    # ctexart 10pt 的 baselineskip 约 12pt，即 1.2 倍字号；
    # 取 1.6 倍再乘 2 作余量，覆盖行间公式、大字号、上下标等撑高的情况。
    return lines * fontsize * 1.6 * 2 + 200.0


def build_width_setup(columns: int, enabled: bool = True) -> tuple[str, str]:
    r"""
    按"终端一行能显示多少列"生成宽度限制，返回 (width_setup, body_prefix)。

    为什么不做事后缩图：缩图会让字变小、变糊，而且判据要猜终端字符格像素宽。
    正确做法是让 LaTeX 在排版阶段就知道可用宽度，自己换行。

    宽度换算：
      终端一列 = 半个中文字宽（西文 1 列、中文 2 列）。
      所以可用文本宽 = columns / 2 个中文字宽：
          \setbox0=\hbox{中}\width = columns/2 * \wd0
      再用 \parbox{\width}{...} 包住正文，超长内容自动折行。

    enabled=False 或 columns<=0 时返回空串，表示不限制宽度。
    """
    if not enabled or columns is None or columns <= 0:
        return "", ""
    em_units = columns / EM_CELLS
    setup = (
        r"\newdimen\SixeltexWidth"
        "\n"
        r"\setbox0=\hbox{中}"
        "\n"
        r"\SixeltexWidth=%.4f\wd0" % em_units
    )
    prefix = r"\parbox{\SixeltexWidth}{\raggedright " 
    return setup, prefix


def wrap_body_for_width(body: str, width_setup: str) -> str:
    r"""
    用 \parbox 包住正文以限制宽度。
    只对"含文本"的内容包裹：纯行间公式（\[...\]）本身宽度由公式决定，
    包 parbox 反而可能破坏行间公式排版，故不包。
    """
    if not width_setup:
        return body
    stripped = body.strip()
    # 纯行间公式 / 纯数学环境：不包（其宽度天然由内容决定）
    if stripped.startswith("\\[") or stripped.startswith("\\begin{equation"):
        return body
    return r"\parbox{\SixeltexWidth}{\raggedright " + stripped + "}"


def _size_to_class_opt(size: float) -> str:
    """
    把任意 pt 字号映射到文档类选项。

    LaTeX 标准文档类只接受离散档位 10pt/11pt/12pt，写任意数值会报
    "Unused global option"。这里显式归到最接近的档位，并如实告知用户
    实际生效的值（不静默偏离用户输入）。
    """
    if size is None:
        return ""
    opts = [(10.0, "10pt"), (11.0, "11pt"), (12.0, "12pt")]
    best = min(opts, key=lambda o: abs(o[0] - size))
    return best[1]


def build_font_setup(fields: dict) -> str:
    """按模板字段生成 fontspec/xeCJK 设置。"""
    cjk = fields.get("cjk_font")
    latin = fields.get("latin_font")
    math = fields.get("math_font")
    if not cjk:
        cjk = FONT_CANDIDATES_CJK[0]
    lines = []
    if latin:
        lines.append(r"\setmainfont{%s}" % latin)
    if cjk:
        lines.append(r"\setCJKmainfont{%s}" % cjk)
    if math:
        lines.append(r"\setmathfont{%s}" % math)
    if not lines:
        return ""
    return "\n".join(lines)


def _hex_to_tex(color: str) -> tuple[str, str] | None:
    """
    '#RRGGBB' -> ('FCFCFC', None)（可直接喂给 xcolor 的 HTML 模型）
    命名色   -> (None, 'white')
    返回 (hex_without_hash, named)；都None表示无法解析。
    """
    c = color.strip()
    # 容错：用户可能把 shell 引号一起传进来，如 "'#ff8800'"
    if len(c) >= 2 and c[0] == c[-1] and c[0] in "'\"":
        c = c[1:-1].strip()
    if c.startswith("#"):
        body = c[1:]
        if len(body) == 6 and all(ch in "0123456789abcdefABCDEF" for ch in body):
            return body.upper(), None
        if len(body) == 3 and all(ch in "0123456789abcdefABCDEF" for ch in body):
            return "".join(ch * 2 for ch in body).upper(), None
        return None
    # 命名色交给 xcolor 自己判断；只接受安全字符，避免注入
    if re.fullmatch(r"[A-Za-z][A-Za-z0-9]*", c):
        return None, c
    return None


def build_cjk_glue() -> str:
    r"""
    生成中文字间距设置，必须放在 \begin{document} 之后。

    xeCJK 的 CJKglue 是汉字之间的粘连量，加一点弹性空隙即可拉开字距。
    带 plus/minus 让 LaTeX 仍能做两端对齐的微调。

    注意：放导言区无效——ctex 在 \begin{document} 时会重设 CJKglue，
    把导言区里设的值覆盖掉（实测导言区设置完全没效果）。
    """
    if LETTER_SPACE_EM <= 0:
        return ""
    return (r"\xeCJKsetup{CJKglue={\hskip %.3fem plus %.3fem minus %.3fem}}"
            % (LETTER_SPACE_EM, LETTER_SPACE_EM * 0.4, LETTER_SPACE_EM * 0.4))


def build_color_setup(fields: dict, fg: str, bg: str) -> str:
    """
    透明背景实现：
      LaTeX 侧只设前景色、不设页面背景（保持透明）
      PNG 侧用 pdftocairo -transp 得带 alpha 的透明图
      最后合成到探测到的终端背景色上 —— 视觉即"透明"

    注意：不能把 '#RRGGBB' 直接写进 \\color{}——'#' 在 LaTeX 里是宏参数标记，
    会报 "Illegal parameter number in definition of \\XC@@tmp"。
    必须先 \\definecolor 定义成颜色名再引用。
    """
    parsed = _hex_to_tex(fg)
    if parsed is None:
        sys.stderr.write("sixeltex: 无法解析前景色 %r，改用默认 %s\n"
                         % (fg, DEFAULT_FG))
        fg = DEFAULT_FG
        parsed = _hex_to_tex(fg)
    hexval, named = parsed
    lines = []
    if hexval:
        lines.append(r"\definecolor{sixeltexfg}{HTML}{%s}" % hexval)
        lines.append(r"\color{sixeltexfg}")
    else:
        lines.append(r"\color{%s}" % named)
    extra = fields.get("color_extra")
    if extra:
        lines.append(extra)
    # 抑制正文首行缩进：单行/公式输出不需要段落缩进
    lines.append(r"\setlength{\parindent}{0pt}")
    lines.append(r"\setlength{\parskip}{0pt}")
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# 5. 输入模式判定
# ---------------------------------------------------------------------------
def is_full_document(text: str) -> bool:
    """
    看第一个命令是不是 \\documentclass。
    找到 \\documentclass 即判定为完整文件模式；否则表达式模式。
    判定依据只看"是否出现"，不做更激进的猜测。
    """
    return re.search(r"\\documentclass", text) is not None


def _looks_like_prose(text: str) -> bool:
    """
    判断输入是否"像散文/混排文本"而不是"纯数学"。
    含中日韩字符，或含大量非数学类西文单词时，认为是正文，
    不再强行套 \\[ ... \\] / align* —— 否则内嵌的 $...$ 会和外层
    定界符冲突（"Display math should end with $$"）。
    """
    if re.search(r"[\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]", text):
        return True
    return False


def _scale_inline(text: str, scale: float | None) -> str:
    r"""对纯数学文本套 \scalebox{factor}{$...$} 实现连续字号缩放。

    注意套裹层级：\scalebox 的参数必须是 $...$ 行内公式，
    不能是 \[ ... \] 行间公式（后者在 hbox 内会报
    "Missing $ inserted"，已实测）。因此缩放在包定界符之前做。

    scale 为 None/1.0 时原样返回。
    含中日韩文字时不缩放（汉字会被撕伸变形）。
    """
    if not scale or scale == 1.0:
        return text
    if _looks_like_prose(text):
        return text
    return r"\scalebox{%s}{$\displaystyle %s$}" % (scale, text)


def _has_math_env(text: str) -> bool:
    """
    检测输入是否自带了"数学类"环境。
    这些环境必须处于数学模式内，直接放进正文会报
    "Missing $ inserted"（如 \begin{pmatrix}）。
    """
    math_envs = (
        "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix", "Vmatrix",
        "smallmatrix", "array", "cases", "dcases", "rcases", "aligned",
        "gathered", "split", "multline", "equation", "align", "gather",
        "flalign", "eqnarray", "subequations",
    )
    for env in math_envs:
        if re.search(r"\\begin\{" + env + r"\*?\}", text):
            return True
    return False


def wrap_expression(text: str, fields: dict, scale: float | None = None) -> str:
    """
    表达式模式：把输入包进合适的环境。
    用户可用 -e/--env 强制指定环境。默认按内容自动选择：
      含 \\begin{...} 已自带环境 -> 原样放入
      含中日韩文字/正文文本       -> 原样作为正文段落（保留其中的 $...$）
      含换行或多个公式            -> align*
      其余（纯数学）              -> \\[ ... \\] 行间公式

    纯数学输入会先剥掉外层一对 $ 或 \\( \\)，避免 \\[$...$\\] 这类
    定界符嵌套冲突（"Display math should end with $$"）。
    """
    text = text.strip()
    # 剥掉外层 $...$（整段被一对 $ 包裹时才剥，避免误伤 $a$$b$ 之类）
    if len(text) >= 2 and text.startswith("$") and text.endswith("$") \
            and not text.startswith("$$") and not text.endswith("$$"):
        inner = text[1:-1]
        if "$" not in inner:
            text = inner.strip()
    # 剥掉外层 \( ... \)
    if text.startswith("\\(") and text.endswith("\\)"):
        inner = text[2:-2]
        if "\\(" not in inner and "\\)" not in inner:
            text = inner.strip()

    env = fields.get("math_env")
    if env:
        return "\\begin{%s}\n%s\n\\end{%s}" % (env, text, env)
    # 正文/混排优先判定：含中文的内容本就是段落文本，
    # 即使内部有 pmatrix 之类的数学环境，也应当由它自己的 $...$
    # 定界符包住，不能在外层再套 \\[...\\]（否则与内层 $
    # 冲突，报 "Display math should end with $$"）。
    if _looks_like_prose(text):
        return text
    if _has_math_env(text):
        # 纯数学环境（无中文）本身就在数学模式内，只需外面套行间定界符
        return "\\[\n%s\n\\]" % text
    if re.search(r"\\begin\{", text):
        # 其它环境（如 itemize/tabular）本就属文本模式，尊重原样
        return text
    if "\n" in text or re.search(r"\\\\", text):
        inner = _scale_inline(text, scale)
        return "\\begin{align*}\n%s\n\\end{align*}" % inner
    inner = _scale_inline(text, scale)
    return "\\[\n%s\n\\]" % inner


# ---------------------------------------------------------------------------
# 6. 编译与渲染管线
# ---------------------------------------------------------------------------
def compile_tex(tex: str, workdir: str) -> str:
    """跑 xelatex，返回生成的 pdf 路径。失败则打印日志尾部并退出。"""
    src = os.path.join(workdir, "sixeltex.tex")
    with open(src, "w", encoding="utf-8") as f:
        f.write(tex)
    logfile = os.path.join(workdir, "xelatex.log")
    with open(logfile, "w", encoding="utf-8") as lf:
        proc = subprocess.run(
            [XELATEX, "-interaction=nonstopmode", "-halt-on-error",
             "-no-shell-escape", "-output-directory", workdir,
             "sixeltex.tex"],
            stdout=lf, stderr=subprocess.STDOUT, cwd=workdir,
            timeout=600,
        )
    pdf = os.path.join(workdir, "sixeltex.pdf")
    if proc.returncode != 0 or not os.path.exists(pdf):
        sys.stderr.write("sixeltex: xelatex 编译失败。日志尾部：\n")
        with open(logfile, encoding="utf-8", errors="replace") as lf:
            sys.stderr.write(lf.read()[-4000:])
        sys.stderr.write("\n提示：用 -k 保留工作目录可查看完整 .tex 与 .log\n")
        sys.exit(1)
    # 顺带报告缺字（不影响退出码，但用户需要知道中文是否渲染出来了）
    with open(logfile, encoding="utf-8", errors="replace") as lf:
        missing = sum(1 for line in lf if "Missing character" in line)
    if missing:
        sys.stderr.write("sixeltex: 警告：检测到 %d 个缺字，"
                         "请检查字体设置（-C / -M）\n" % missing)
    return pdf


def _bbox_from_pdftotext(pdf: str) -> tuple[float, float, float, float] | None:
    r"""
    用 pdftotext -bbox 取所有字符的精确边界（PDF 坐标系，原点左上）。

    gs 的 bbox 设备对上下标、\left(...\right)、积分号伸出的部分判断偏紧，
    会裁掉字形（实测：含 $x_1$ $x^2$ 的文本，gs 给 11.9pt 高，
    而 pdftotext 的字符边界是 14.3pt 高）。所以以字符边界为准。

    返回 (x0, y0_top, x1, y1_top)；失败返回 None。
    """
    proc = subprocess.run(["pdftotext", "-bbox", pdf, "-"],
                          capture_output=True, text=True, timeout=300)
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    xs0 = []
    ys0 = []
    xs1 = []
    ys1 = []
    page_h = None
    for m in re.finditer(r'<page\s+width="([\d.]+)"\s+height="([\d.]+)"', proc.stdout):
        page_h = float(m.group(2))
        break
    for m in re.finditer(
            r'xMin="([\d.-]+)"\s+yMin="([\d.-]+)"\s+xMax="([\d.-]+)"\s+yMax="([\d.-]+)"',
            proc.stdout):
        x0, y0, x1, y1 = (float(g) for g in m.groups())
        xs0.append(x0); ys0.append(y0); xs1.append(x1); ys1.append(y1)
    if not xs0 or page_h is None:
        return None
    return min(xs0), min(ys0), max(xs1), max(ys1)


def crop_pdf(pdf: str, workdir: str, pad_pt: float = 6.0,
             keep_width: bool = True) -> str:
    r"""
    计算内容边界后写进 CropBox，得到紧凑页面。

    边界来源（取并集，宁可多留也不裁字）：
      1. pdftotext -bbox 的字符级边界 —— 覆盖上下标、积分号等
      2. ghostscript 的 HiResBoundingBox —— 覆盖纯图形（tikz 线条等无字符内容）

    再四周各留 pad_pt(pt) 安全边距，避免抗锯齿边缘被切。

    pad_pt 取 4.0 而非 1.0：bbox 终究是估算，字符的降部、积分号下端等
    可能略微超出。1pt 经超采样缩放后只剩约 1px，任何舍入偏差都会让末行
    底部被切（实测多列宽下底部留白都只有 1px）。4pt 缩放后约 6px，
    肉眼几乎不增加空白，但足够兜住估算误差。

    keep_width=True 时左右不裁剪，保留整页宽度（页面宽度本身已按终端列数
    设定），只裁剪上下。左右裁紧会在两端切掉字形边缘或间距，故默认保留。

    为何不用 preview 包：ctexart 下 preview 只裁到第一个公式，
    多行/混排内容会整段丢失（已实测）。
    """
    boxes = []

    # 1) 字符级边界（转成 PDF 坐标：左下原点）
    tb = _bbox_from_pdftotext(pdf)
    if tb is not None:
        tx0, ty0_top, tx1, ty1_top = tb
        # 取页面高度换算
        info = subprocess.run(["pdfinfo", pdf], capture_output=True, text=True,
                              timeout=120)
        # 注意："Page size:  595.28 x 841.89 pts (A4)" 拆开后
        #   ['Page','size:','595.28','x','841.89','pts','(A4)']
        # 高度在索引 4，索引 2 是宽度。曾因此把宽度当成高度，
        # 导致 CropBox 的 y 坐标错位、图片下方留白。
        page_h = 0.0
        for line in info.stdout.splitlines():
            if line.lower().startswith("page size:"):
                nums = re.findall(r"[\d.]+", line)
                try:
                    page_h = float(nums[1])
                except (IndexError, ValueError):
                    page_h = 0.0
                break
        if page_h > 0:
            boxes.append((tx0, page_h - ty1_top, tx1, page_h - ty0_top))
        else:
            boxes.append((tx0, -ty1_top, tx1, -ty0_top))

    # 2) gs 的矢量边界
    proc = subprocess.run(
        [GS, "-dNOPAUSE", "-dBATCH", "-sDEVICE=bbox", pdf],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=300,
    )
    err = proc.stderr.decode("utf-8", "replace")
    m = re.search(r"%%HiResBoundingBox:\s*([\d.-]+)\s+([\d.-]+)\s+([\d.-]+)\s+([\d.-]+)",
                  err)
    if m:
        boxes.append(tuple(float(g) for g in m.groups()))

    if not boxes:
        sys.stderr.write("sixeltex: 无法获取内容边界，按整页渲染\n")
        return pdf

    x0 = min(b[0] for b in boxes)
    y0 = min(b[1] for b in boxes)
    x1 = max(b[2] for b in boxes)
    y1 = max(b[3] for b in boxes)

    # 安全边距，并夹到页面内
    info = subprocess.run(["pdfinfo", pdf], capture_output=True, text=True,
                          timeout=120)
    page_w = page_h2 = 0.0
    for line in info.stdout.splitlines():
        if line.lower().startswith("page size:"):
            try:
                parts = line.split()
                page_w = float(parts[2])
                page_h2 = float(parts[4])
            except (IndexError, ValueError):
                pass
            break
    y0 = max(0.0, y0 - pad_pt)
    if keep_width and page_w > 0:
        # 左右不裁：直接取整页宽度
        x0 = 0.0
        x1 = page_w
    else:
        x0 = max(0.0, x0 - pad_pt)
        if page_w > 0:
            x1 = min(page_w, x1 + pad_pt)
        else:
            x1 = x1 + pad_pt
    if page_h2 > 0:
        y1 = min(page_h2, y1 + pad_pt)
    else:
        y1 = y1 + pad_pt

    out = os.path.join(workdir, "sixeltex-cropped.pdf")
    subprocess.run(
        [GS, "-dNOPAUSE", "-dBATCH", "-sDEVICE=pdfwrite", "-o", out,
         "-c", "[ /CropBox [%.4f %.4f %.4f %.4f] /PAGES pdfmark" % (x0, y0, x1, y1),
         "-f", pdf],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=300, cwd=workdir,
    )
    return out if os.path.exists(out) else pdf


def pdf_to_transparent_png(pdf: str, workdir: str, dpi: int) -> str:
    """pdftocairo -transp 得到带 alpha 的透明 PNG。"""
    prefix = os.path.join(workdir, "sixeltex")
    subprocess.run(
        [PDFTOCAIRO, "-png", "-r", str(dpi), "-singlefile",
         "-cropbox", "-transp", pdf, prefix],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
        timeout=300, check=True,
    )
    png = prefix + ".png"
    if not os.path.exists(png):
        raise RuntimeError("pdftocairo 未生成 PNG")
    return png


def _ink_bbox(png: str, alpha_pct: int = 0) -> tuple:
    """
    返回图像中"可见墨迹"的包围盒 (w, h, x, y)。

    用 ImageMagick 的 %@（trim 包围盒）。透传 PNG 的四角是透明的，
    得到的就是字形占据的区域，不含透明留白。

    alpha_pct > 0 时先把 alpha 通道按该百分比二值化再求包围盒，用于
    忽略抗锯齿的极淡尾巴——那些像素对视觉几乎无贡献，却会把"墨迹底"
    往下推几个像素，进而让终端多算一整行（底部凭空多出空白）。
    读不到时返回 (0, 0, 0, 0)。
    """
    if alpha_pct > 0:
        cmd = [MAGICK, png, "-alpha", "extract",
               "-threshold", "%d%%" % alpha_pct, "-format", "%@", "info:"]
    else:
        cmd = [MAGICK, png, "-format", "%@", "info:"]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        return (0, 0, 0, 0)
    m = re.match(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", r.stdout.strip())
    if not m:
        return (0, 0, 0, 0)
    return tuple(int(g) for g in m.groups())


def resize_for_terminal(png: str, target_w: int | None = None,
                        supersample: int = 1,
                        colors: int | None = None,
                        cell_h_px: float | None = None,
                        transparent: bool = False) -> str:
    r"""
    把高 DPI 渲染出的 PNG 缩到终端像素尺寸，并对齐 sixel 条带高度。

    两步都做，缺一不可：

    1. 超采样缩小（解决"发糊"）
       LaTeX 按 base_dpi * supersample 渲染，得到远大于终端像素的图。
       若直接把这张图编码成 sixel，终端会强行压缩到列宽，导致失真。
       先用 Lanczos 缩到目标宽度（列数 * 字符格宽），
       等效于高质量抗锯齿，比直接按目标 DPI 渲染取样密度高。

    2. 底部补透明像素到 6 的倍数（解决"黑带"）
       sixel 每 6 行一个带，高度非 6 倍数时最后一个带不满，
       终端会用背景色填充剩余部分，视觉上出现一条异色带。
       补在底部（-gravity south）而非顶部，避免把内容往下推。

    保留 alpha 通道——由调用方决定是否合成背景色。
    """
    work = os.path.dirname(png)
    w, h = _image_size(png)

    if supersample and supersample > 1:
        if target_w and target_w > 0 and w > target_w:
            new_w = target_w
            new_h = max(1, int(round(h * target_w / float(w))))
        else:
            new_w = max(1, w // supersample)
            new_h = max(1, h // supersample)
        scaled = os.path.join(work, "sixeltex-scaled.png")
        cmd = [MAGICK, png, "-filter", "Lanczos",
               "-resize", "%dx%d!" % (new_w, new_h)]
        # 缩放后立即量化到指定颜色数。Lanczos 会在字形边缘产生大量
        # 抗锯齿中间色（实测 231 种），若不在此收敛，这些颜色会全部
        # 带进 sixel 调色板，既臃肿又让边缘发灰。
        if colors and colors > 1:
            cmd += ["-colors", str(int(colors))]
        subprocess.run(
            cmd + [scaled],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=300, check=True)
        png, w, h = scaled, new_w, new_h

    # 底部留白，要同时满足两件事：
    #
    # 1) 留够空隙，别让末行降部贴边。PDF 侧的 pad_pt 经超采样缩小后可能
    #    只剩 1px，故这里在像素空间再补几像素。
    #
    # 2) 不要让图像高度跨到下一个终端行，否则终端会为那一条窄带多推进
    #    一整行，看起来就是末尾凭空多出一个空行。
    #    终端按 ceil(图像高 / 字符格高) 推进行数，所以要压在
    #    ceil(h / cell_h) * cell_h 之内。
    #
    # 优先对齐到 6 的倍数（sixel 条带整齐）；若那个高度会越过行边界，
    # 就退让到行边界本身——透传模式(P2=1)下末带没填满的行本来就是透明的，
    # 不对齐 6 也不会出现异色带。
    if transparent and cell_h_px and cell_h_px >= 1:
        # 透传模式：把高度精确压到"字形刚好占满整数行"。
        #
        # 终端按 ceil(图像高 / 字符格高) 推进行数，图像之外不可能再省；
        # 但图像**内部**多出来的透明留白是可以裁掉的——那正是肉眼看到的
        # 那段空白。
        #
        # 做法：先量出字形实际占的包围盒，算出它需要几行，取该行边界
        # 作为高度上限；图像比上限高就裁掉底部透明部分（绝不碰字形，
        # 因为上限恒 >= 字形底边），比上限矮就补到 上限 与 原高+2 的较小值。
        cell_h = int(round(cell_h_px))
        if cell_h > 0:
            iw, ih, ix, iy = _ink_bbox(png, alpha_pct=50)
            if ih > 0 and iy + ih <= h:
                ink_bottom = iy + ih          # 字形底边（不含的下一行）
                rows = -(-ink_bottom // cell_h)
                limit = rows * cell_h

                # 能少占一行就少占一行：若压缩幅度在上限内，把整幅图
                # 垂直压到上一档行边界，墨迹底刚好贴住边界，底部空白归零。
                if rows > 1:
                    lower = (rows - 1) * cell_h
                    # 压缩比要以"墨迹高度"为基准：整幅图按 f 缩放后，
                    # 墨迹也按 f 缩，要让它落到 lower 以内，f <= lower/ink。
                    # 用图像高度（含透明留白）当分母会严重高估所需压缩量。
                    if lower >= cell_h and ink_bottom > 0:
                        ratio = lower / float(ink_bottom)
                        if 1.0 - ratio <= MAX_VERTICAL_SQUASH:
                            # 按 f 缩放整幅图（不是直接压到 lower），
                            # 这样墨迹正好缩到 lower，压缩量才是所需的最小值
                            new_h = max(1, int(round(h * ratio)))
                            squashed = os.path.join(work, "sixeltex-squash.png")
                            subprocess.run(
                                [MAGICK, png, "-filter", "Lanczos",
                                 "-resize", "%dx%d!" % (w, new_h), squashed],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                timeout=300, check=True)
                            png, h = squashed, new_h
                            rows, limit = rows - 1, lower

                # 填到行边界：图像正好占满整行，终端推进后不会在图像
                # 之外再留半行；这段填充是透明的，视觉上就是行间距本身。
                want = limit
                if want < h:
                    # 裁掉超出的透明底边
                    cropped = os.path.join(work, "sixeltex-tight.png")
                    subprocess.run(
                        [MAGICK, png, "-crop", "%dx%d+0+0" % (w, want),
                         "+repage", cropped],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        timeout=300, check=True)
                    png, h = cropped, want
                elif want > h:
                    padded = os.path.join(work, "sixeltex-padded.png")
                    subprocess.run(
                        [MAGICK, png, "-background", "none",
                         "-gravity", "south", "-splice", "0x%d" % (want - h), padded],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        timeout=300, check=True)
                    png, h = padded, want
    elif not transparent:
        # 不透明模式：背景是实色，末带不满会露一条异色窄带，故补齐到 6 的倍数
        total = (-(-h // 6) * 6) - h
        if total > 0:
            padded = os.path.join(work, "sixeltex-padded.png")
            subprocess.run(
                [MAGICK, png, "-background", "none",
                 "-gravity", "south", "-splice", "0x%d" % total, padded],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=300, check=True)
            png, h = padded, h + total

    return png


def composite_bg(png: str, bg: str, out: str, margin: int = 0) -> str:
    r"""
    合成背景色：把透明 PNG 铺到指定背景色上，得到不透明图。

    超采样缩小与高度对齐已由 resize_for_terminal() 完成，
    这里只负责最后一步"把 alpha 抹掉、烧成实色"。
    """
    # --- 留白 + 合成背景色 ---
    cmd = [MAGICK, png]
    if margin and margin > 0:
        cmd += ["-bordercolor", "transparent", "-border", str(margin)]
    cmd += ["-background", bg, "-alpha", "remove", "-alpha", "off", out]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=300, check=True)
    return out


def _image_size(png: str) -> tuple[int, int]:
    """读 PNG 像素尺寸。用 ImageMagick 的 %w/%h 格式，避免自解析 PNG 头。"""
    out = subprocess.run([MAGICK, png, "-format", "%w %h", "info:"],
                         capture_output=True, text=True, timeout=120)
    if out.returncode != 0:
        raise RuntimeError("无法读取图片尺寸: %s" % png)
    try:
        w, h = out.stdout.split()
        return int(w), int(h)
    except ValueError:
        raise RuntimeError(
            "无法解析图片尺寸（输出 %r）: %s" % (out.stdout.strip(), png))


def _parse_color_rgb(color: str) -> tuple:
    """
    把颜色字符串解析成 (r, g, b)，每个分量 0-255。

    支持 '#RRGGBB' / '#RGB' / 命名色（交给 ImageMagick 解析）。
    无法解析时抛 RuntimeError。
    """
    c = color.strip()
    # 容错：剥掉可能一并传入的 shell 引号
    if len(c) >= 2 and c[0] == c[-1] and c[0] in "'\"":
        c = c[1:-1].strip()

    if c.startswith("#"):
        body = c[1:]
        if len(body) == 3 and all(ch in "0123456789abcdefABCDEF" for ch in body):
            body = "".join(ch * 2 for ch in body)
        if len(body) == 6 and all(ch in "0123456789abcdefABCDEF" for ch in body):
            return (int(body[0:2], 16), int(body[2:4], 16), int(body[4:6], 16))
        raise RuntimeError("颜色格式错误: %r" % color)

    # 命名色：让 ImageMagick 解析
    r = subprocess.run(
        [MAGICK, "xc:" + c,
         "-format", "%[fx:int(255*r)].%[fx:int(255*g)].%[fx:int(255*b)]",
         "info:"],
        capture_output=True, text=True, timeout=60)
    if r.returncode == 0:
        try:
            rr, gg, bb = (int(x) for x in r.stdout.strip().split("."))
            return (rr, gg, bb)
        except ValueError:
            pass
    raise RuntimeError("无法识别的颜色: %r" % color)


def encode_transparent_sixel(png: str, fg: str,
                             colors: int = 256,
                             bg: str | None = None) -> bytes:
    """
    透传 sixel 编码器：只编码 alpha>0 的字形像素，背景像素不写色。

    这样终端的原有背景/内容能透出来，实现"背景完全透明"（sixel 协议本身无 alpha 通道，只能用"不写背景色"达到透传效果）。

    DCS 头用 P2=1（background color mode = transparent）告诉终端空像素保持原样。
    foot 的 sixel.c 即以 p2 == 1 判定透明；若发 P2=0（如 icat/ImageMagick 默认），空像素会被填成当前背景色。

    颜色支持：
      * 默讨用 ImageMagick 把图量化到 `colors` 色的自适应调色版，逐像素按调色版索引编码，
        因此彩色内容（tikz / \textcolor 等）能正确呈现。
      * `fg` 仅在图片本就是嗅嗃（零色）时作为固定前景色：此时跳过量化，
        把所有字形像素统一拉到前景色，避免量匒把反锯齿过程产生的灰度分层。

    为什么不用 ImageMagick 的 sixel coder：它无法表达"背景不写色"，会把 alpha=0 的区域量化成某个不透明色。
    libsixel 的 img2sixel 在部分构建下输出恒为 0 字节，故自写编码器。
    本编码器输出已用 libsixel 自带的 sixel2png 反向解码验证过。
    """
    import colorsys

    # 取 RGBA 原始像素
    proc = subprocess.run([MAGICK, png, "-depth", "8", "rgba:-"],
                          capture_output=True, timeout=300)
    if proc.returncode != 0:
        raise RuntimeError("读取 PNG 像素失败")
    data = proc.stdout
    w, h = _image_size(png)
    if len(data) != w * h * 4:
        raise RuntimeError("像素数据长度不符: %d != %d"
                           % (len(data), w * h * 4))

    # 颜色表：(r,g,b) -> 索引；索引从 1 开始，0 保留给"不写色"。
    # max_colors 同时是调色板容量：超出后新颜色归入最接近的已有色。
    palette = {}
    index_of = {}
    max_colors = max(2, min(int(colors), 255))
    # 调色板已满时的最近邻缓存：同一个 RGB 不必反复重算
    near_of: dict = {}

    def idx_for(r: int, g: int, b: int) -> int:
        key = (r, g, b)
        i = index_of.get(key)
        if i is not None:
            return i

        if len(palette) < max_colors:
            i = len(palette) + 1
            palette[i] = key
            index_of[key] = i
            return i

        # 调色板已满：归入最接近的已有色
        i = near_of.get(key)
        if i is not None:
            return i
        best, best_d = 1, None
        for (pr2, pg2, pb2), pi in index_of.items():
            d = (pr2 - r) ** 2 + (pg2 - g) ** 2 + (pb2 - b) ** 2
            if best_d is None or d < best_d:
                best, best_d = pi, d
        near_of[key] = best
        return best

    # alpha 阈值二值化：>32 视为字形（滤掉抗锯齿边缘的微透明）
    alphas = data[3::4]

    # 决定是否走"固定前景色"快速路径：图片本质上是否嗁嗃。
    # 判据：取所有不透明像素，若它们的饱和度全都为 0（灰度），
    # 则认为是嗁嗃文字，用 fg 统一拉到前景色。
    opaque_rgb = []
    for i in range(0, len(data), 4):
        if data[i + 3] > 32:
            opaque_rgb.append((data[i], data[i + 1], data[i + 2]))
    is_greyscale = bool(opaque_rgb) and all(
        r == g == b for (r, g, b) in opaque_rgb[:4096])

    # 前景色：灰度文字统一拉到这个颜色，避免把抗锯齿的灰度分层
    # 当成真实颜色带进调色板。
    fg_rgb = None
    if is_greyscale and fg:
        fg_rgb = _parse_color_rgb(fg)

    # 参考背景色：只用于给字形边缘做 alpha 混合。
    # sixel 没有 alpha 通道，若把 alpha 直接二值化，边缘就只剩"有/无"
    # 两级，视觉上全是锯齿。把边缘像素按 alpha 混到终端背景色上，
    # 等价于画出"字形→背景"的过渡，肉眼即是反锯齿。
    # 空隙（alpha 极低）仍然不写色，所以背景依然是透的。
    bg_rgb = None
    if bg:
        try:
            bg_rgb = _parse_color_rgb(bg)
        except RuntimeError:
            bg_rgb = None

    # alpha 低于此值视为空白，不写色（保留透传）。
    # 取 24/255≈9%：再低就是肉眼不可见的噪点，写出来反而在
    # 透明背景上形成淡淡的杂点。
    A_MIN = 24

    # alpha 量化级数。反锯齿不需要 200 多级灰度：把 alpha 归到
    # 有限档位后，调色板规模从"每个边缘像素一色"降到"每档一色"，
    # 输出体积和编码耗时都大幅下降。8 档在此尺寸下肉眼已看不出
    # 阶梯（实测 55 级 -> 8 级，视觉无差别）。
    A_STEPS = 8

    def shade(base_rgb: tuple, a: float) -> tuple:
        """按覆盖率 a 把 base 颜色混到背景色；无背景信息时原样返回。"""
        if bg_rgb is None or a >= 0.985:
            return base_rgb
        # 量化到 A_STEPS 档，取档中点减少整体偏暗/偏亮
        q = min(A_STEPS, int(a * A_STEPS) + 1)
        aq = q / float(A_STEPS)
        return tuple(int(round(c * aq + bk * (1.0 - aq)))
                     for c, bk in zip(base_rgb, bg_rgb))

    # 一次遍历算出每个像素的颜色索引，同时按带归档。
    # 直接产出「每带每列的颜色位图」比"按颜色反复全扫条带"快得多：
    # 后者是 6*w*颜色数 次操作，前者每像素只处理一次。
    all_idx = [0] * (w * h)
    for y in range(h):
        base = y * w
        for x in range(w):
            idx = base + x
            a8 = alphas[idx]
            if a8 < A_MIN:
                continue
            if fg_rgb is not None:
                base_rgb = fg_rgb
            else:
                o = idx * 4
                base_rgb = (data[o], data[o + 1], data[o + 2])
            all_idx[idx] = idx_for(*shade(base_rgb, a8 / 255.0))

    out = bytearray()
    out += b"\x1bP0;1;0q"                      # DCS + P2=1(透明) + q
    out += ('"1;1;%d;%d' % (w, h)).encode()    # 栅格属性

    # 调色版定义：sixel 用百分比 (0-100) 表示颜色分量
    for i in sorted(palette):
        r, g, b = palette[i]
        out += ("#%d;2;%d;%d;%d" % (
            i,
            int(round(r * 100 / 255.0)),
            int(round(g * 100 / 255.0)),
            int(round(b * 100 / 255.0)))).encode()

    # 逐条带编码。
    #
    # sixel 的带推进规则决定了换色写法，这里很容易踩坑：
    #   `-` (DECGNL) 推进到下一带（6 行），
    #   `$` (DECGCR) 只把当前位置退回本带左端，不推进。
    # 因此同一带内换色必须用 `$`，只有本带最后一个颜色才用 `-`。
    # 若对每个颜色都写 `-`，N 个颜色就把光标推进 N*6 行，
    # 图像会被拉成 N 倍高、各色错行——即"撕裂的点点"。
    for y0 in range(0, h, 6):
        # 扫一遍本带 6 行，按颜色收集每列的位掩码。
        # 这样每个像素只处理一次，而不是"按颜色反复全扫条带"。
        col_masks = [None] * w          # 每列：{颜色索引: 位掩码}
        present = []
        seen_local = set()
        for k in range(6):
            y = y0 + k
            if y >= h:
                break
            base = y * w
            bit = 1 << k
            for x in range(w):
                i = all_idx[base + x]
                if not i:
                    continue
                m = col_masks[x]
                if m is None:
                    m = col_masks[x] = {}
                m[i] = m.get(i, 0) | bit
                if i not in seen_local:
                    seen_local.add(i)
                    present.append(i)

        if not present:
            # 整带全空：仍需推进 6 行，否则后续内容会错位
            out += b"-"
            continue

        for n, i in enumerate(present):
            band = [0] * w
            for x in range(w):
                m = col_masks[x]
                if m is not None:
                    v = m.get(i)
                    if v:
                        band[x] = v
            # RLE 压缩（重复 >=4 次才值得写）
            parts = []
            p = 0
            while p < w:
                q2 = p
                v = band[p]
                while q2 < w and band[q2] == v:
                    q2 += 1
                cnt = q2 - p
                ch = chr(v + 63)
                if cnt >= 4:
                    parts.append("!%d%s" % (cnt, ch))
                else:
                    parts.append(ch * cnt)
                p = q2
            out += ("#%d" % i).encode() + "".join(parts).encode("ascii")
            # 本带还有其它颜色 -> 回车复用本带；已是最后一个 -> 推进
            out += b"$" if n < len(present) - 1 else b"-"
    out += b"\x1b\\"                            # ST
    return bytes(out)


def png_to_sixel_transparent(png: str, fg: str,
                             colors: int = 256,
                             bg: str | None = None) -> None:
    """透传模式：编码并写到 stdout。"""
    try:
        sixel = encode_transparent_sixel(png, fg, colors, bg)
    except (RuntimeError, OSError) as e:
        sys.stderr.write("sixeltex: sixel 编码失败: %s\n" % e)
        sys.exit(1)
    sys.stdout.buffer.write(sixel)
    sys.stdout.buffer.flush()


def _strip_icat_filename_prefix(data: bytes) -> bytes:
    r"""
    剔掉 icat 在 sixel 数据前面打印的文件名行。

    icat 的输出形如：  b"/tmp/xxx.png:\n\x1bP0;0;8q..."
    那份文件名会被终端当普通文本显示，必须去掉。
    找到第一个 sixel DCS 起始序列 ESC P 的位置，从那里截取。
    取首个而非最后一个，是为了保留文件名行之后可能出现的其它控制序列。
    """
    idx = data.find(b"\x1bP")
    if idx > 0:
        return data[idx:]
    return data


def _go_style_arch() -> str:
    r"""
    把本机架构换算成 Go 的 GOARCH 命名（vendor 目录用的是这套）。

    uname 的 machine 名与 Go 的 GOARCH 名不一致，必须显式映射：
      x86_64 -> amd64      aarch64/arm64 -> arm64
    未知架构返回空串，此时 _project_icat_candidates() 的候选路径
    会指向不存在的目录，由调用处的 os.path.isfile 判掉，不会误用。
    """
    try:
        machine = os.uname().machine
    except (AttributeError, OSError):
        return ""
    return {
        "x86_64": "amd64",
        "amd64": "amd64",
        "aarch64": "arm64",
        "arm64": "arm64",
    }.get(machine, "")


def _project_icat_candidates() -> list[str]:
    r"""
    列出随本仓库分发的 icat 启动脚本候选路径（按平台）。

    icat 是动态链接的第三方二进制，依赖的 .so 收在 vendor/icat/<平台>/lib/ 下，
    必须经同目录的 run 脚本启动（由它设置 LD_LIBRARY_PATH），不能直接跑 bin/icat。

    路径相对本脚本位置推导，因此不依赖当前工作目录，也不依赖安装位置。
    平台目录名格式为 <GOOS>-<GOARCH>，如 linux-amd64。
    """
    here = os.path.dirname(os.path.abspath(__file__))
    if sys.platform.startswith("linux"):
        goos = "linux"
    elif sys.platform == "darwin":
        goos = "darwin"
    elif sys.platform.startswith("win"):
        goos = "windows"
    else:
        return []
    arch = _go_style_arch()
    if not arch:
        return []
    root = os.path.join(here, "vendor", "icat", "%s-%s" % (goos, arch))
    return [os.path.join(root, "run")]


def _icat_path() -> str | None:
    r"""
    定位 icat。顺序：仓库自带 -> PATH -> 常见安装目录。

    仓库自带优先，是为了 clone 下来即可用、不要求使用者额外装 icat；
    若使用者已在 PATH 里装了 icat，也会被下面第二个分支接住。
    （Go 的 `go install` 默认落在 ~/go/bin，该目录常不在 PATH 里。）
    """
    for cand in _project_icat_candidates():
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    found = shutil.which("icat")
    if found:
        return found
    for cand in (
        os.path.expanduser("~/go/bin/icat"),
        os.path.expanduser("~/.local/bin/icat"),
        "/usr/local/bin/icat",
        "/usr/bin/icat",
    ):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def png_to_sixel_opaque(png: str, colors: int,
                        disp_w: int | None = None,
                        disp_h: int | None = None) -> None:
    r"""
    用 icat 展示图片，强制 sixel 协议。

    icat 默认会自动探测终端支持哪种图形协议（kitty / sixel / iterm），
    探测不到就报 "term graphics not available"。
    用 TERM_GRAPHICS=sixel 强制指定，无需终端应答任何探测序列。

    disp_w / disp_h：按探测到的终端像素尺寸显式指定显示宽高。
    icat 的 -W / -H 只认纯数字（实测 "100px" 无效、"50%" 会放大），
    所以这里直接传整数像素值，避免它自行缩放导致尺寸漂移。

    参数 colors 已不再使用（由 icat 自己决定调色板），
    保留形参以便调用处不变。
    """
    exe = _icat_path()
    if not exe:
        sys.stderr.write("sixeltex: 未找到 icat，无法展示图片\n")
        sys.stderr.write("  请安装 icat，或确认它在 PATH 中\n")
        sys.exit(127)

    env = dict(os.environ)
    env["TERM_GRAPHICS"] = "sixel"   # 强制 sixel，不让 icat 自动探测

    cmd = [exe]
    if disp_w and disp_w > 0:
        cmd += ["-W", str(int(disp_w))]
    if disp_h and disp_h > 0:
        cmd += ["-H", str(int(disp_h))]
    cmd.append(png)

    proc = subprocess.run(
        cmd,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        timeout=300, env=env,
    )
    data = _strip_icat_filename_prefix(proc.stdout)
    if proc.returncode != 0 or not data or not data.startswith(b"\x1bP"):
        sys.stderr.write("sixeltex: icat 输出异常\n")
        if proc.stderr:
            sys.stderr.write(proc.stderr.decode("utf-8", "replace")[-2000:])
        sys.stderr.write("  尝试: TERM_GRAPHICS=sixel icat <图片>\n")
        sys.exit(1)
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()



