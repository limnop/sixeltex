# 2. 依赖探测 —— 全部显式确认，缺失即报错退出，不静默兜底
# ---------------------------------------------------------------------------
def check_dependencies() -> None:
    """确认外部命令都在。任一缺失立即报错并说明缺什么。"""
    missing = []
    # (显示名, 候选命令名元组, 对应模块级常量名)
    probes = [
        ("xelatex", ("xelatex",), "XELATEX"),
        ("ghostscript (gs)", ("gs",), "GS"),
        ("pdftocairo", ("pdftocairo",), "PDFTOCAIRO"),
        ("ImageMagick", MAGICK_CANDIDATES, "MAGICK"),
    ]
    for name, candidates, const in probes:
        resolved = None
        for cand in candidates:
            resolved = shutil.which(cand)
            if resolved is not None:
                break
        if resolved is None:
            missing.append(name)
        else:
            # 把探到的真实路径写回常量，后续一律用绝对路径调用
            globals()[const] = resolved
    if missing:
        sys.stderr.write("sixeltex: 缺少依赖: " + ", ".join(missing) + "\n")
        sys.stderr.write("  请先安装后重试。\n")
        sys.exit(127)


# ---------------------------------------------------------------------------
# 3. 终端颜色探测（OSC 10/11），继承 sixelmath 的三级回退思路
# ---------------------------------------------------------------------------
def _osc_query(ps: int) -> str | None:
    """向终端查询默认前景(10)/背景(11)色。非 TTY 或超时返回 None。"""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    try:
        import select
        import termios
        import tty
    except ImportError:
        # Windows 无这三个模块；颜色探测本就只是优化项，直接放弃即可
        return None
    try:
        fd = sys.stdin.fileno()
        orig = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            sys.stdout.write("\x1b]{};?\x1b\\".format(ps))
            sys.stdout.flush()
            buf = b""
            # 最多等 300ms，终端不响应就放弃（sixelmath 在此处会永久阻塞）
            while True:
                r, _, _ = select.select([fd], [], [], 0.3)
                if not r:
                    return None
                ch = os.read(fd, 1)
                if not ch:
                    return None
                buf += ch
                if buf.endswith((b"\x1b\\", b"\x07")):
                    break
        finally:
            termios.tcsetattr(fd, termios.TCSANOW, orig)
    except Exception:
        return None
    s = buf.decode("utf-8", "replace")
    m = re.fullmatch(r"\x1B\]" + str(ps) + r";(.+)(?:\x1B\\|\x07)", s)
    if not m:
        return None
    return m.group(1)


def _osc_to_hex(color: str) -> str | None:
    """rgb:RR/GG/BB -> #RRGGBB。用正则而非固定下标切片（sixelmath 的隐患）。"""
    m = re.fullmatch(r"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)", color)
    if not m:
        return None
    parts = []
    for g in m.groups():
        # 终端可能返回 4 位(16bit)或 2 位(8bit)分量，统一缩放到 8 位
        if len(g) <= 2:
            parts.append(g.rjust(2, "0"))
        elif len(g) == 4:
            parts.append(g[:2])
        else:
            parts.append(g[:2].ljust(2, "0"))
    return "#" + "".join(p.lower() for p in parts)


def detect_fg() -> str:
    """前景色：命令行 > OSC 探测 > $SIXELTEX_FG > 默认值"""
    v = _osc_query(10)
    if v:
        h = _osc_to_hex(v)
        if h:
            return h
    env = os.environ.get("SIXELTEX_FG")
    if env:
        return env
    return DEFAULT_FG


def detect_bg() -> str:
    """背景色：命令行 > OSC 探测 > $SIXELTEX_BG > 默认值"""
    v = _osc_query(11)
    if v:
        h = _osc_to_hex(v)
        if h:
            return h
    env = os.environ.get("SIXELTEX_BG")
    if env:
        return env
    return DEFAULT_BG


