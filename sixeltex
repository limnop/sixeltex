# ---------------------------------------------------------------------------
# 2.5 终端几何探测 —— 宽度（字符数）、字号（pt）、DPI
# ---------------------------------------------------------------------------
# 字号探测原理：
#   向终端发 CSI 14 t（查询文本区像素尺寸）和 CSI 18 t（查询文本区字符尺寸），
#   两者相除得到"字符格高度(像素)"，再按本机 DPI 折算成 pt：
#       字号(pt) = 字符格高(px) / DPI * 72
#   任一环节拿不到就回退，最终回退 FALLBACK_FONTSIZE_PT（10pt）。
FALLBACK_FONTSIZE_PT = 10.0

# 本机探明的 DPI（~/.Xresources 的 Xft.dpi = 96）。
# 这是"默认值不可信"原则下的显式实测值；探测失败时用它折算。
PROBED_DPI = 96.0

# 宽度回退：shutil.get_terminal_size() 拿不到时用 80 列
FALLBACK_COLUMNS = 80

# 探测到的字符格宽度(px)，宽度自适应用；None 表示未探测到
_CELL_W_PX: float | None = None
# 探测到的字符格高度(px)，用来算 DPI 使公式字高对齐终端
_CELL_H_PX: float | None = None


def _read_dpi() -> float:
    """
    读取本机 DPI。顺序：$SIXELTEX_DPI -> Xft.dpi(xrdb) -> 96。
    只读操作，失败不影响主流程。
    """
    env = os.environ.get("SIXELTEX_DPI")
    if env:
        try:
            v = float(env)
            if v > 0:
                return v
        except ValueError:
            pass
    try:
        r = subprocess.run(["xrdb", "-query"], capture_output=True,
                           text=True, timeout=10)
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[0].lower() == "xft.dpi":
                try:
                    v = float(parts[1])
                    if v > 0:
                        return v
                except ValueError:
                    pass
    except (OSError, subprocess.SubprocessError):
        pass
    return PROBED_DPI


def _osc_geometry_query(timeout: float = 0.4) -> tuple[int, int, int, int] | None:
    """
    向终端查询文本区尺寸。返回 (像素高, 像素宽, 字符行, 字符列)，失败返回 None。

    CSI 14 t -> 终端回复 CSI 4 ; 高 ; 宽 t
    CSI 18 t -> 终端回复 CSI 8 ; 行 ; 列 t
    只在真实 TTY 下发；非 TTY 直接放弃（不阻塞、不报错）。
    """
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    import select
    import termios
    import tty
    try:
        fd = sys.stdin.fileno()
        orig = termios.tcgetattr(fd)
    except (termios.error, OSError, ValueError):
        return None
    try:
        tty.setcbreak(fd)
        px_h = px_w = ch_h = ch_w = None
        # 一次发两个查询，然后分别读两类响应
        sys.stdout.write("\x1b[14t\x1b[18t")
        sys.stdout.flush()
        deadline = _monotonic() + timeout
        buf = b""
        while _monotonic() < deadline:
            if px_h is not None and ch_h is not None:
                break
            r, _, _ = select.select([fd], [], [], 0.1)
            if not r:
                continue
            ch = os.read(fd, 4096)
            if not ch:
                break
            buf += ch
            # CSI 4 ; 高 ; 宽 t
            for m in re.finditer(rb"\x1b\[4;(\d+);(\d+)t", buf):
                px_h, px_w = int(m.group(1)), int(m.group(2))
            # CSI 8 ; 行 ; 列 t
            for m in re.finditer(rb"\x1b\[8;(\d+);(\d+)t", buf):
                ch_h, ch_w = int(m.group(1)), int(m.group(2))
        if px_h and px_w and ch_h and ch_w:
            return px_h, px_w, ch_h, ch_w
        return None
    except Exception:
        return None
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSANOW, orig)
        except (termios.error, OSError, ValueError):
            pass


def _monotonic() -> float:
    import time
    return time.monotonic()


def detect_fontsize_pt(verbose: bool = False) -> float:
    """
    探测终端字号(pt)。失败一律回退 FALLBACK_FONTSIZE_PT(10)。

    链路：CSI 14t/18t 算字符格高 -> /DPI*72 得 pt。
    同时把探测到的字符格宽度(px)存进模块级变量，供宽度自适应使用。
    """
    geo = _osc_geometry_query()
    if geo is None:
        return FALLBACK_FONTSIZE_PT
    px_h, px_w, ch_h, ch_w = geo
    if not ch_h or not ch_w or not px_h or not px_w:
        return FALLBACK_FONTSIZE_PT
    cell_h = px_h / ch_h
    cell_w = px_w / ch_w
    dpi = _read_dpi()
    pt = cell_h / dpi * 72.0
    # 记录字符格尺寸(px)：宽用于宽度估算，高用于算 DPI
    global _CELL_W_PX, _CELL_H_PX
    _CELL_W_PX = cell_w
    _CELL_H_PX = cell_h
    if verbose:
        sys.stderr.write(
            "sixeltex: 终端 %dx%d 字符, %dx%d 像素, 字符格 %.1fx%.1fpx, "
            "DPI %g -> 字号 %.2fpt\n"
            % (ch_w, ch_h, px_w, px_h, cell_w, cell_h, dpi, pt))
    # 明显离谱的值（<6pt 或 >40pt）视为探测失败
    if pt < 6.0 or pt > 40.0:
        return FALLBACK_FONTSIZE_PT
    return pt


def detect_terminal_columns() -> int:
    r"""
    探测终端"一行能显示多少个字符格"（列数）。失败回退 FALLBACK_COLUMNS。

    探测顺序（先精确后兜底）：
      1. os.get_terminal_size() —— 直接对 stdout/stderr/stdin 做 ioctl
         （已在真 TTY 下实测：pty 设为 60/120/200 列都能精确读到）
      2. shutil.get_terminal_size() —— 内部同样按 fd 尝试，并回退 $COLUMNS
      3. $COLUMNS —— 部分 shell 会导出
      4. FALLBACK_COLUMNS(80) —— 全部失败时

    返回的是"列数"而非像素。中文占 2 列、西文占 1 列，
    所以一列恰好是"半个中文字"的宽度，这正是排版限制宽度的单位。
    """
    for fh in (sys.stdout, sys.stderr, sys.stdin):
        try:
            cols = os.get_terminal_size(fh.fileno()).columns
            if cols > 0:
                return cols
        except (OSError, ValueError, AttributeError):
            continue
    try:
        cols = shutil.get_terminal_size().columns
        if cols > 0:
            return cols
    except Exception:
        pass
    try:
        cols = int(os.environ.get("COLUMNS", "0"))
        if cols > 0:
            return cols
    except (TypeError, ValueError):
        pass
    return FALLBACK_COLUMNS


